@startuml activity-urgency
!include _style.iuml
title UrgencyRules.classify(event, now, urgentMinutes)
start
if (已归档？) then (是)
  :ARCHIVED 已归档;
  stop
endif
if (已完成？) then (是)
  :COMPLETED 已完成;
  stop
endif
:remaining = 截止时间 − 当前时间;
if (remaining ≤ 0？) then (是)
  :OVERDUE 已逾期（灰显）;
  stop
endif
if (填写了速通时间 且 remaining ≤ 速通时间？) then (是)
  :DANGER 速通危险期（红色、感叹号）;
  stop
endif
if (remaining ≤ 变橙阈值（默认 1 天）？) then (是)
  :SOON 临近截止（橙色）;
else (否)
  :NORMAL 时间充裕（蓝色）;
endif
stop
@enduml
