<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cn.edu.hust.ddlsaver.qa.clipboard"
    android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <application android:label="DDL Saver QA Clipboard"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false" android:fullBackupContent="false"
        android:supportsRtl="true">
        <activity android:name=".ClipboardFixtureActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".FixtureProvider"
            android:authorities="cn.edu.hust.ddlsaver.qa.clipboard.files"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
